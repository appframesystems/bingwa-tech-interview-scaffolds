### Tasks API Testing (All endpoints are protected)
@baseUrl = http://localhost:3000/api

### First, login to get token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "SecurePass123!"
}

### Save the accessToken from response
### @accessToken = YOUR_JWT_TOKEN

###

### ============================================
### 1. Create a task
### ============================================
POST {{baseUrl}}/tasks
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "title": "Build the complete API",
  "description": "Create full CRUD operations for tasks",
  "priority": "HIGH"
}

###

### ============================================
### 2. Create another task
### ============================================
POST {{baseUrl}}/tasks
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "title": "Write API documentation",
  "description": "Document all endpoints with examples",
  "priority": "MEDIUM",
  "status": "TODO"
}

###

### ============================================
### 3. Create a task with due date
### ============================================
POST {{baseUrl}}/tasks
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "title": "Test the API with Flutter",
  "description": "Integrate backend with Flutter frontend",
  "priority": "HIGH",
  "status": "IN_PROGRESS",
  "dueDate": "2026-09-01"
}

###

### ============================================
### 4. Get all tasks with pagination
### ============================================
GET {{baseUrl}}/tasks?page=1&limit=10
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 5. Get tasks with status filter
### ============================================
GET {{baseUrl}}/tasks?status=COMPLETED
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 6. Get tasks with priority filter
### ============================================
GET {{baseUrl}}/tasks?priority=HIGH
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 7. Get tasks with search
### ============================================
GET {{baseUrl}}/tasks?search=API
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 8. Get task statistics
### ============================================
GET {{baseUrl}}/tasks/stats/dashboard
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 9. Get tasks by status
### ============================================
GET {{baseUrl}}/tasks/status/TODO
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 10. Get a single task by ID
### ============================================
GET {{baseUrl}}/tasks/TASK_ID
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 11. Update a task
### ============================================
PATCH {{baseUrl}}/tasks/TASK_ID
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "title": "Updated task title",
  "priority": "LOW",
  "status": "IN_PROGRESS"
}

###

### ============================================
### 12. Mark task as complete
### ============================================
PATCH {{baseUrl}}/tasks/TASK_ID/complete
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 13. Batch update tasks
### ============================================
POST {{baseUrl}}/tasks/batch
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "taskIds": ["TASK_ID_1", "TASK_ID_2"],
  "updateData": {
    "status": "COMPLETED"
  }
}

###

### ============================================
### 14. Soft delete a task
### ============================================
DELETE {{baseUrl}}/tasks/TASK_ID
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 15. Restore a soft-deleted task
### ============================================
PATCH {{baseUrl}}/tasks/TASK_ID/restore
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### 16. Hard delete a task (permanent)
### ============================================
DELETE {{baseUrl}}/tasks/TASK_ID/hard
Authorization: Bearer YOUR_JWT_TOKEN

###
